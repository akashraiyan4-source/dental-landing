# Copy to .env.local for local development. On Vercel set the same keys in Project -> Settings -> Environment Variables.
# Only NEXT_PUBLIC_* values are exposed to the browser - never put secrets in this project.

# Base URL of the Universal Backend (no trailing slash, no /api suffix).
# Local backend:  http://localhost:4000   (run it with: next dev -p 4000)
# Production:     https://smileway-backend.vercel.app
# Leave unset to use the production default.
NEXT_PUBLIC_BACKEND_URL=https://smileway-backend.vercel.app
